{
  "compilerOptions": {
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "target": "es2022",
    "module": "es2022",
    "baseUrl": ".",
    "rootDir": ".",
    "typeRoots": ["node_modules/@types"],
    "lib": ["es2022", "dom"],
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "paths": {
      "@wiki-app/*": ["playwright/app/*"],
      "@wiki-pages/*": ["playwright/app/pages/*"],
      "@wiki-components/*": ["playwright/app/component/*"],
      "@wiki-test-data/*": ["playwright/fixtures/*"],
      "@wiki-fixtures/*": ["playwright/fixtures/fixtures/*"],
      "@wiki-helpers/*": ["playwright/helpers/*"],
      "@wiki-types/*": ["playwright/types/*"],
      "@wiki-utils/*": ["playwright/utils/*"]
    }
  },
  "exclude": ["node_modules"],
  "include": ["playwright/**/*.ts", "*.ts"]
}
